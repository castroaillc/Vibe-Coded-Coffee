# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Neon Postgres (Vercel → Storage → Neon adds these automatically) ──
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection, used for migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Admin (/admin: CRM + POS) ─────────────────────────
# Comma-separated emails allowed into /admin. Sign in there with an emailed code.
ADMIN_EMAILS=

# ── Better Auth ───────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Resend (email sign-in codes + waitlist emails) ────
# Leave RESEND_API_KEY empty locally to print emails in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM="Vibe Coded Coffee <hello@vibecodedcoffee.com>"
# Where "Book us for your event" requests are sent (defaults to the site email in lib/site.ts)
BOOKING_NOTIFY_EMAIL=

# ── Stripe (membership with 30-day free trial) ───────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MEMBERSHIP_PRICE_ID=price_...

# ── Pass + kiosk ──────────────────────────────────────
# Signs the daily QR on each member's pass. Generate with: openssl rand -base64 32
PASS_SIGNING_SECRET=
# The kiosk sends this as "Authorization: Bearer <KIOSK_API_KEY>". Generate with: openssl rand -hex 24
KIOSK_API_KEY=
